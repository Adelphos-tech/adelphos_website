# ── SMTP Credentials ─────────────────────────────────────────────────────────
#
#  For Hostinger / cPanel hosting:
#    SMTP_HOST = smtp.hostinger.com
#    SMTP_PORT = 587
#    SMTP_SECURE = false
#    SMTP_USER = info@adelphostech.com
#    SMTP_PASS = (your email account password)
#
# ─────────────────────────────────────────────────────────────────────────────

SMTP_HOST=smtp.hostinger.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=info@adelphostech.com
SMTP_PASS=

# Server port (the website will be served on this port)
PORT=3000

# ── Admin Panel ──────────────────────────────────────────────────────────────
ADMIN_PASSWORD=changeme-strong-password-here
SESSION_SECRET=generate-a-random-long-string-for-sessions

# ── Groq AI Analyst ──────────────────────────────────────────────────────────
GROQ_API_KEY=gsk_your_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# ── Google APIs (optional — see GOOGLE_API_SETUP.md) ─────────────────────────
GOOGLE_SERVICE_ACCOUNT_KEY=/path/to/service-account-key.json
GA4_PROPERTY_ID=123456789
SEARCH_CONSOLE_SITE=https://adelphostech.com/
